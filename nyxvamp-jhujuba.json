  "theme": {
    "primary": {
      "dark": "function_fg",
      "light": "function_fg"
    },
    "secondary": {
      "dark": "type_fg",
      "light": "type_fg"
    },
    "accent": {
      "dark": "keyword_fg",
      "light": "keyword_fg"
    },
    "error": {
      "dark": "error_fg",
      "light": "error_fg"
    },
    "warning": {
      "dark": "warning_fg",
      "light": "warning_fg"
    },
    "success": {
      "dark": "string_fg",
      "light": "string_fg"
    },
    "info": {
      "dark": "info_fg",
      "light": "info_fg"
    },
    "text": {
      "dark": "foreground",
      "light": "foreground"
    },
    "textMuted": {
      "dark": "comment_fg",
      "light": "comment_fg"
    },
    "background": {
      "dark": "background",
      "light": "background"
