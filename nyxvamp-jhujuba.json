      "dark": "foreground",
      "light": "foreground"
    },
    "markdownHeading": {
      "dark": "markup_heading_fg",
      "light": "markup_heading_fg"
    },
    "markdownLink": {
      "dark": "markup_link_url_fg",
      "light": "markup_link_url_fg"
    },
    "markdownLinkText": {
      "dark": "markup_link_text_fg",
      "light": "markup_link_text_fg"
    },
    "markdownCode": {
      "dark": "string_fg",
      "light": "string_fg"
    },
    "markdownBlockQuote": {
      "dark": "markup_quote_fg",
      "light": "markup_quote_fg"
    },
    "markdownEmph": {
      "dark": "markup_italic_fg",
      "light": "markup_italic_fg"
    },
    "markdownStrong": {
      "dark": "markup_bold_fg",
      "light": "markup_bold_fg"
    },
    "markdownHorizontalRule": {
