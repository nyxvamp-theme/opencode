    "markdownListItem": {
      "dark": "keyword_fg",
      "light": "keyword_fg"
    },
    "markdownListEnumeration": {
      "dark": "number_fg",
      "light": "number_fg"
    },
    "markdownImage": {
      "dark": "markup_link_url_fg",
      "light": "markup_link_url_fg"
    },
    "markdownImageText": {
      "dark": "markup_link_text_fg",
      "light": "markup_link_text_fg"
    },
    "markdownCodeBlock": {
      "dark": "foreground",
      "light": "foreground"
    },
    "syntaxComment": {
      "dark": "comment_fg",
      "light": "comment_fg"
    },
    "syntaxKeyword": {
      "dark": "keyword_fg",
      "light": "keyword_fg"
    },
    "syntaxFunction": {
      "dark": "function_fg",
      "light": "function_fg"
    },
    "syntaxVariable": {
      "dark": "variable_fg",
      "light": "variable_fg"
    },
    "syntaxString": {
      "dark": "string_fg",
      "light": "string_fg"
    },
    "syntaxNumber": {
      "dark": "number_fg",
      "light": "number_fg"
    },
    "syntaxType": {
      "dark": "type_fg",
      "light": "type_fg"
    },
    "syntaxOperator": {
      "dark": "operator_fg",
      "light": "operator_fg"
    },
    "syntaxPunctuation": {
      "dark": "punctuation_fg",
      "light": "punctuation_fg"
    }
